{
  "manifest_version": 3,
  "name": "Whoami YouTube Music Bridge",
  "version": "1.0.0",
  "description": "Publishes the current YouTube Music track to the Whoami Now Playing panel.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://whowho-website.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Whoami YouTube Music Bridge",
    "default_popup": "options.html"
  }
}
