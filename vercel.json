{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{admin.html,whoami.html,*.gif,*.jpg,*.jpeg,*.png,*.webp,*.svg,*.ico,public/**,css/**,api/**}"
    },
    "server.js": {
      "includeFiles": "{admin.html,whoami.html,*.gif,*.jpg,*.jpeg,*.png,*.webp,*.svg,*.ico,public/**,css/**,api/**}"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/whoami.html" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/admin", "destination": "/api" },
    { "source": "/admin.html", "destination": "/api" }
  ]
}